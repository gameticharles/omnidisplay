#!/bin/bash

# omarchy:summary=Tablet and virtual displays for OmniDisplay (headless output + wayvnc)
# omarchy:group=omnidisplay
#
# Turns a tablet, phone or another computer into a screen: a virtual output
# (Extend) or the existing screen (Mirror) is served over VNC by wayvnc.
#
# Local only by default: wayvnc listens on 127.0.0.1, reachable through an
# SSH tunnel. Network access always means TLS plus a username and a generated
# password; there is no unencrypted network mode. The password never appears
# in argv or in the QR code (which carries only the address).
#
# Commands
#   status                              JSON for the panel
#   start <extend|mirror> <WxH@R> <left|right|above|below> <local|network> [output]
#   stop
#   regenerate                          new password (and certificate) for network mode
#   qr <png-path>                       QR code of vnc://<address>:<port>
#
# Inspired by Adamya Gupta's omarchy-virtual-display and Kyotroo's
# omarchy-tablet-display; reimplemented here. See NOTICE.

set -uo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
CTL="$(dirname -- "$SELF")/omnidisplay-ctl"
HYPRCTL="${OMNIDISPLAY_HYPRCTL:-hyprctl}"
WAYVNC="${OMNIDISPLAY_WAYVNC_BIN:-wayvnc}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
VNC_DIR="$CONFIG_HOME/omarchy/omnidisplay/vnc"
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp/omnidisplay-$UID}/omnidisplay"
PID_FILE="$RUN_DIR/wayvnc.pid"
SESSION_FILE="$RUN_DIR/vnc-session.json"
VIRTUAL="OMNI-TAB1"
PORT="${OMNIDISPLAY_VNC_PORT:-5900}"
USERNAME="omnidisplay"
MARKER="__omnidisplay_exit="

die() { printf '%s\n' "$*" >&2; exit 2; }

private_dir() {
  [[ -L $1 ]] && return 1
  [[ -e $1 ]] || mkdir -p -m 700 -- "$1" || return 1
  [[ -d $1 && -O $1 ]] || return 1
  chmod 700 -- "$1"
}

running_pid() {
  local pid
  [[ -f $PID_FILE ]] || return 1
  pid=$(cat -- "$PID_FILE" 2>/dev/null)
  [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/cmdline ]] || return 1
  tr '\0' '\n' <"/proc/$pid/cmdline" | head -n1 | grep -q 'wayvnc$' || return 1
  echo "$pid"
}

lan_addresses() {
  ip -o -4 addr show scope global 2>/dev/null | awk '{ split($4, a, "/"); printf "%s\t%s\n", $2, a[1] }'
}

ensure_credentials() {
  private_dir "$VNC_DIR" || die "cannot use $VNC_DIR"
  if [[ ! -s $VNC_DIR/password ]]; then
    (umask 077; head -c 18 /dev/urandom | base64 | tr -d '/+=' | head -c 16 >"$VNC_DIR/password")
  fi
  if [[ ! -s $VNC_DIR/tls_key.pem || ! -s $VNC_DIR/tls_cert.pem ]]; then
    command -v openssl >/dev/null 2>&1 || die "openssl is needed for network mode"
    (umask 077; openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:secp384r1 -nodes -days 3650 \
       -subj "/CN=omnidisplay" -keyout "$VNC_DIR/tls_key.pem" -out "$VNC_DIR/tls_cert.pem" >/dev/null 2>&1) ||
      die "could not create a TLS certificate"
  fi
}

write_config() {
  local network="$1" cfg="$VNC_DIR/wayvnc.config"
  private_dir "$VNC_DIR" || die "cannot use $VNC_DIR"
  if [[ $network == network ]]; then
    ensure_credentials
    (umask 077; cat >"$cfg" <<EOF
use_relative_paths=true
address=0.0.0.0
port=$PORT
enable_auth=true
username=$USERNAME
password=$(cat -- "$VNC_DIR/password")
private_key_file=tls_key.pem
certificate_file=tls_cert.pem
EOF
)
  else
    (umask 077; printf 'address=127.0.0.1\nport=%s\n' "$PORT" >"$cfg")
  fi
  echo "$cfg"
}

cmd_status() {
  local pid="" installed=false qr=false session="{}"
  command -v "$WAYVNC" >/dev/null 2>&1 && installed=true
  command -v qrencode >/dev/null 2>&1 && qr=true
  pid=$(running_pid) || pid=""
  [[ -n $pid && -f $SESSION_FILE ]] && session=$(cat -- "$SESSION_FILE")
  local password=""
  if [[ -n $pid ]] && jq -e '.access == "network"' <<<"$session" >/dev/null 2>&1; then
    password=$(cat -- "$VNC_DIR/password" 2>/dev/null)
  fi
  lan_addresses | jq -Rn \
    --argjson installed "$installed" --argjson qr "$qr" --arg pid "$pid" \
    --argjson session "$session" --arg password "$password" --arg user "$USERNAME" --argjson port "$PORT" \
    '{installed: $installed, qrencode: $qr, running: ($pid != ""), session: $session,
      port: $port, username: $user, password: $password,
      addresses: [inputs | split("\t") | {interface: .[0], address: .[1]}]}'
}

cmd_start() {
  local mode="${1:-}" size="${2:-}" side="${3:-right}" access="${4:-local}" target="${5:-}"
  [[ $mode =~ ^(extend|mirror)$ ]] || die "mode must be extend or mirror"
  [[ $size =~ ^[0-9]{3,5}x[0-9]{3,5}@[0-9]{2,3}$ ]] || die "size must look like 1920x1200@60"
  [[ $side =~ ^(left|right|above|below)$ ]] || die "side must be left, right, above or below"
  [[ $access =~ ^(local|network)$ ]] || die "access must be local or network"
  [[ -z $target || $target =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "bad output name"
  command -v "$WAYVNC" >/dev/null 2>&1 || die "wayvnc is not installed"
  private_dir "$RUN_DIR" || die "cannot use $RUN_DIR"
  running_pid >/dev/null && die "a tablet session is already running"

  local output="$target"
  if [[ $mode == extend ]]; then
    "$CTL" headless create "$VIRTUAL" "$size" >/dev/null || die "could not create the virtual display"
    output="$VIRTUAL"
    local pos
    case "$side" in
      left) pos="auto-left" ;; right) pos="auto-right" ;; above) pos="auto-up" ;; below) pos="auto-down" ;;
    esac
    "$HYPRCTL" eval "hl.monitor({ output = \"$VIRTUAL\", mode = \"$size\", position = \"$pos\", scale = 1, transform = 0, mirror = \"\", disabled = false })" >/dev/null 2>&1
  elif [[ -z $output ]]; then
    output=$("$HYPRCTL" monitors -j | jq -r '[.[] | select(.focused)][0].name // ""')
  fi

  local cfg
  cfg=$(write_config "$access") || exit 2
  setsid -f "$WAYVNC" --config="$cfg" --output="$output" </dev/null >"$RUN_DIR/wayvnc.log" 2>&1
  local i=0 pid=""
  while (( i < 30 )); do
    pid=$(pgrep -n -u "$UID" -x wayvnc) && break
    sleep 0.1; i=$((i + 1))
  done
  if [[ -z $pid ]]; then
    [[ $mode == extend ]] && "$CTL" headless remove "$VIRTUAL" >/dev/null
    echo "wayvnc did not start: $(tail -n 3 "$RUN_DIR/wayvnc.log" 2>/dev/null)"
    printf '%s1\n' "$MARKER"
    return
  fi
  printf '%s' "$pid" >"$PID_FILE"
  jq -cn --arg mode "$mode" --arg size "$size" --arg side "$side" --arg access "$access" --arg output "$output" \
    '{mode: $mode, size: $size, side: $side, access: $access, output: $output}' >"$SESSION_FILE"
  printf '%s0\n' "$MARKER"
}

cmd_stop() {
  local pid
  if pid=$(running_pid); then
    kill -TERM "$pid" 2>/dev/null
    local i=0
    while kill -0 "$pid" 2>/dev/null && (( i < 30 )); do sleep 0.1; i=$((i + 1)); done
    kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
  fi
  rm -f -- "$PID_FILE" "$SESSION_FILE"
  if "$HYPRCTL" monitors all -j 2>/dev/null | jq -e --arg n "$VIRTUAL" 'any(.[]; .name == $n)' >/dev/null; then
    "$CTL" headless remove "$VIRTUAL" >/dev/null
  fi
  printf '%s0\n' "$MARKER"
}

cmd_regenerate() {
  private_dir "$VNC_DIR" || die "cannot use $VNC_DIR"
  rm -f -- "$VNC_DIR/password" "$VNC_DIR/tls_key.pem" "$VNC_DIR/tls_cert.pem"
  ensure_credentials
  printf '%s0\n' "$MARKER"
}

cmd_qr() {
  local png="${1:-}" address
  [[ $png == "$RUN_DIR"/*.png && $png != *..* ]] || die "the QR image goes in $RUN_DIR"
  command -v qrencode >/dev/null 2>&1 || die "qrencode is not installed"
  private_dir "$RUN_DIR" || die "cannot use $RUN_DIR"
  address=$(lan_addresses | head -n1 | cut -f2)
  [[ -n $address ]] || die "no network address"
  qrencode -o "$png" -s 8 -m 2 "vnc://$address:$PORT" || die "qrencode failed"
  printf '%s0\n' "$MARKER"
}

cmd="${1:-}"
shift || true
case "$cmd" in
  status) cmd_status ;;
  start) cmd_start "$@" ;;
  stop) cmd_stop ;;
  regenerate) cmd_regenerate ;;
  qr) cmd_qr "${1:-}" ;;
  *) sed -n '3,20p' "$SELF" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
